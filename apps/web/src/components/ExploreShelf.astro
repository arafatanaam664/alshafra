---
import type { ExploreGroup } from '@alshafra/content/explore';

interface Props {
  groups: ExploreGroup[];
  compact?: boolean;
}

const { groups, compact = false } = Astro.props;
const visible = groups.filter((group) => group.links.length > 0);
---
{visible.length > 0 && (
  <div class:list={[compact ? 'space-y-6' : 'mt-12 space-y-8']}>
    {visible.map((group) => (
      <section aria-labelledby={`explore-${group.key}`}>
        <h2 id={`explore-${group.key}`} class:list={[compact ? 'text-sm font-bold' : 'text-lg font-bold']}>
          {group.title}
        </h2>
        <div class:list={[compact ? 'mt-2 space-y-2' : 'mt-3 grid gap-2 sm:grid-cols-2']}>
          {group.links.map((link) => (
            <a
              class="card block p-3 text-sm font-medium leading-6 text-ink-800 transition hover:-translate-y-0.5"
              href={link.path}
              data-link-reason={link.reason}
            >
              {link.title}
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
)}
