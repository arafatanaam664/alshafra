---
import {
  applyWeekendRule,
  formatGregorian,
  formatHijri,
  gregorianToHijri,
  todayGregorian,
  weekdayName,
} from '@alshafra/calendar';
import { publicHome } from '../content/sections-public';

const g = todayGregorian();
const h = gregorianToHijri(g.year, g.month, g.day);
const today = {
  weekday: weekdayName(g),
  gregorian: formatGregorian(g),
  hijri: formatHijri(h),
};

function nextPay(dayOfMonth: number) {
  const from = todayGregorian();
  for (let offset = 0; offset < 3; offset++) {
    const month = ((from.month - 1 + offset) % 12) + 1;
    const year = from.year + Math.floor((from.month - 1 + offset) / 12);
    const adjusted = applyWeekendRule({ year, month, day: dayOfMonth });
    const a = Date.UTC(from.year, from.month - 1, from.day);
    const b = Date.UTC(adjusted.year, adjusted.month - 1, adjusted.day);
    if (b >= a) {
      return {
        text: formatGregorian(adjusted),
        days: Math.round((b - a) / 86400000),
      };
    }
  }
  return { text: formatGregorian(from), days: 0 };
}

const salary = nextPay(27);
const sections = publicHome();
const calendar = sections.find((section) => section.key === 'calendar');
const tools = sections.find((section) => section.key === 'tools');
const guides = sections.find((section) => section.key === 'guides');
const articles = sections.find((section) => section.key === 'articles');

const quick = [
  ['/today', 'التاريخ اليوم'],
  ['/date-converter', 'تحويل التاريخ'],
  ['/salaries', 'مواعيد الرواتب'],
  ['/countdown/ramadan', 'كم باقي على رمضان'],
  ['/gold-price', 'سعر الذهب'],
  ['/age-calculator', 'حاسبة العمر'],
];
---

<section class="border-b border-ink-900/10">
  <div class="container-page grid items-end gap-10 pb-16 pt-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="eyebrow">Alshafra</p>
      <h1 class="mt-4 max-w-3xl text-balance text-4xl font-bold leading-[1.2] sm:text-5xl">
        المعرفة والأدوات والخدمات في مكان واحد.
      </h1>
      <p class="lede mt-5">
        حوّل التاريخ، تابع مواعيد الرواتب، واقرأ أدلة عملية بلا تشتيت. كل صفحة تؤدي إلى الصفحة التالية التي تحتاجها.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        {calendar && <a class="btn-primary" href={calendar.path}>{calendar.name}</a>}
        {tools && <a class="btn-ghost" href={tools.path}>{tools.name}</a>}
        <a class="btn-ghost" href="/search">بحث</a>
      </div>
    </div>
    <aside class="grid gap-3 lg:col-span-5">
      <a href="/today" class="card p-6 transition hover:-translate-y-0.5">
        <p class="eyebrow">اليوم</p>
        <p class="mt-3 text-2xl font-bold">{today.weekday}</p>
        <p class="mt-1 text-ink-800">{today.hijri}</p>
        <p class="text-sm text-ink-700">{today.gregorian}</p>
        <p class="mt-4 text-sm font-semibold text-iris-600">افتح التاريخ اليوم</p>
      </a>
      <a href="/salaries" class="card p-5 transition hover:-translate-y-0.5">
        <p class="eyebrow">أقرب راتب حكومي</p>
        <p class="mt-2 text-lg font-bold">{salary.text}</p>
        <p class="text-sm text-ink-700">{salary.days === 0 ? 'اليوم' : `بعد ${salary.days} يومًا`} — بعد قاعدة نهاية الأسبوع</p>
      </a>
    </aside>
  </div>
</section>

<section class="container-page py-8">
  <div class="flex flex-wrap gap-2">
    {quick.map(([href, label]) => (
      <a href={href} class="chip hover:bg-white">{label}</a>
    ))}
  </div>
</section>

<section class="container-page pb-16">
  <h2 class="text-2xl font-bold">الأقسام</h2>
  <p class="mt-2 max-w-2xl text-sm leading-7 text-ink-700">ابدأ من القسم، ثم انتقل إلى صفحاته دون الرجوع للبحث في كل مرة.</p>
  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {sections.map((section) => (
      <a href={section.path} class="group card flex flex-col p-6 transition hover:-translate-y-0.5">
        <h3 class="text-xl font-bold">{section.name}</h3>
        <p class="mt-2 flex-1 text-sm leading-7 text-ink-700">{section.description}</p>
        {section.children.length > 0 && (
          <p class="mt-4 text-xs leading-6 text-ink-700">
            {section.children.slice(0, 4).map((child) => child.name).join(' · ')}
          </p>
        )}
        <span class="mt-5 text-sm font-semibold text-iris-600 group-hover:underline">تصفح القسم</span>
      </a>
    ))}
  </div>
</section>

{calendar && (
  <section class="bg-ink-900 py-16 text-sand-50">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-3xl font-bold">{calendar.name}</h2>
        <a class="text-sm text-iris-300 hover:underline" href={calendar.path}>كل القسم</a>
      </div>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-white/65">{calendar.description}</p>
      <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {calendar.children.map((item) => (
          <a href={item.path} class="rounded-2xl bg-white/5 p-5 ring-1 ring-white/10 transition hover:bg-white/10">
            <h3 class="font-bold">{item.name}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

{tools && (
  <section class="container-page py-16">
    <h2 class="text-2xl font-bold">{tools.name}</h2>
    <p class="mt-2 text-sm leading-7 text-ink-700">{tools.description}</p>
    <div class="mt-6 flex flex-wrap gap-2">
      {tools.children.map((item) => (
        <a href={item.path} class="rounded-full bg-white px-4 py-2 text-sm font-medium ring-1 ring-ink-900/10 hover:ring-iris-500">{item.name}</a>
      ))}
      <a href={tools.path} class="rounded-full bg-ink-900 px-4 py-2 text-sm font-medium text-white">كل الأدوات</a>
    </div>
  </section>
)}

{(guides || articles) && (
  <section class="border-t border-ink-900/8 bg-sand-100/60 py-16">
    <div class="container-page grid gap-10 lg:grid-cols-2">
      {guides && (
        <div>
          <h2 class="text-2xl font-bold">{guides.name}</h2>
          <p class="mt-2 text-sm leading-7 text-ink-700">{guides.description}</p>
          <ul class="mt-5 space-y-2">
            {guides.children.map((item) => (
              <li><a class="text-sm font-medium text-sea-700 hover:underline" href={item.path}>{item.name}</a></li>
            ))}
          </ul>
        </div>
      )}
      {articles && (
        <div>
          <h2 class="text-2xl font-bold">{articles.name}</h2>
          <p class="mt-2 text-sm leading-7 text-ink-700">{articles.description}</p>
          <ul class="mt-5 space-y-2">
            {articles.children.map((item) => (
              <li><a class="text-sm font-medium text-sea-700 hover:underline" href={item.path}>{item.name}</a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
)}

<section class="container-page py-12">
  <div class="card max-w-3xl p-6">
    <h2 class="text-lg font-bold">قبل أن تعتمد الرقم</h2>
    <p class="mt-2 text-sm leading-7 text-ink-700">
      المواعيد استرشادية وفق تقويم أم القرى وتوقيت الرياض وقاعدة نهاية الأسبوع. راجع المصدر الرسمي قبل أي قرار.
    </p>
  </div>
</section>
