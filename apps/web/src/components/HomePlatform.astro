---
import {
  formatGregorian,
  formatHijri,
  gregorianToHijri,
  todayGregorian,
  weekdayName,
} from '@alshafra/calendar';
import { publicHome } from '../content/sections-public';

const g = todayGregorian();
const h = gregorianToHijri(g.year, g.month, g.day);
const today = {
  weekday: weekdayName(g),
  gregorian: formatGregorian(g),
  hijri: formatHijri(h),
};
const sections = publicHome();
const calendar = sections.find((section) => section.key === 'calendar');
const tools = sections.find((section) => section.key === 'tools');
---

<section class="hero-mesh relative overflow-hidden text-white">
  <div class="hero-grid pointer-events-none absolute inset-0 opacity-70"></div>
  <div class="container-page relative grid min-h-[82vh] items-end gap-12 pb-20 pt-16 lg:grid-cols-12">
    <div class="lg:col-span-8">
      <p class="eyebrow">Alshafra</p>
      <h1 class="mt-5 max-w-4xl text-balance font-display text-4xl font-bold leading-[1.15] sm:text-6xl">
        المعرفة والأدوات والخدمات في مكان واحد.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-9 text-white/70">
        منصة عربية للمعلومات العملية: مواعيد وتقويم، أدوات حساب، وأدلة ومقالات تساعدك على إنجاز ما تبحث عنه.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        {calendar && <a class="btn-primary" href={calendar.path}>{calendar.name}</a>}
        {tools && <a class="btn-ghost" href={tools.path}>{tools.name}</a>}
        <a class="btn-ghost" href="/search">بحث</a>
      </div>
    </div>
    <aside class="lg:col-span-4">
      <a href="/today" class="block rounded-3xl bg-white/5 p-6 ring-1 ring-white/10 backdrop-blur-md transition hover:bg-white/10">
        <p class="text-xs font-semibold uppercase tracking-brand text-iris-300">اليوم</p>
        <p class="mt-4 font-display text-2xl font-bold">{today.weekday}</p>
        <p class="mt-2 text-white/80">{today.hijri}</p>
        <p class="text-sm text-white/50">{today.gregorian}</p>
        <p class="mt-5 text-sm text-iris-300">التاريخ اليوم</p>
      </a>
      <form action="/search" method="get" role="search" class="mt-4 flex gap-2">
        <label class="sr-only" for="home-q">بحث</label>
        <input id="home-q" name="q" class="w-full rounded-full bg-white/5 px-4 py-2.5 text-sm text-white ring-1 ring-white/15 placeholder:text-white/35" placeholder="تحويل التاريخ، الرواتب، النسبة…" maxlength="80" />
        <button class="btn-primary" type="submit">بحث</button>
      </form>
    </aside>
  </div>
</section>

<section class="bg-sand-50 py-20">
  <div class="container-page">
    <h2 class="section-title">الأقسام</h2>
    <p class="mt-3 max-w-2xl text-sm leading-7 text-ink-800/70">اختر القسم الذي تحتاجه. كل قسم يجمع صفحاته وأدواته في مكان واحد.</p>
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {sections.map((section) => (
        <a href={section.path} class="group card flex flex-col p-6 transition hover:-translate-y-0.5">
          <h3 class="text-xl font-bold">{section.name}</h3>
          <p class="mt-2 flex-1 text-sm leading-7 text-ink-800/70">{section.description}</p>
          <span class="mt-5 text-sm font-semibold text-iris-600 group-hover:underline">تصفح القسم</span>
        </a>
      ))}
    </div>
  </div>
</section>

{calendar && (
  <section class="bg-ink-900 py-20 text-white">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-display text-3xl font-bold">{calendar.name}</h2>
        <a class="text-sm text-iris-300 hover:underline" href={calendar.path}>كل القسم</a>
      </div>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-white/65">{calendar.description}</p>
      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {calendar.children.map((item) => (
          <a href={item.path} class="rounded-2xl bg-white/5 p-5 ring-1 ring-white/10 transition hover:bg-white/10">
            <h3 class="font-bold">{item.name}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

{tools && (
  <section class="bg-sand-50 py-20">
    <div class="container-page">
      <h2 class="section-title">{tools.name}</h2>
      <p class="mt-3 text-sm leading-7 text-ink-800/70">{tools.description}</p>
      <div class="mt-8 flex flex-wrap gap-2">
        {tools.children.map((item) => (
          <a href={item.path} class="rounded-full bg-white px-4 py-2 text-sm font-medium ring-1 ring-ink-900/10 hover:ring-iris-500">{item.name}</a>
        ))}
        <a href={tools.path} class="rounded-full bg-ink-900 px-4 py-2 text-sm font-medium text-white">كل الأدوات</a>
      </div>
      <div class="mt-14 card max-w-3xl p-6">
        <h3 class="text-lg font-bold">معلومة مهمة</h3>
        <p class="mt-2 text-sm leading-7 text-ink-800/70">
          المواعيد المعروضة استرشادية وفق تقويم أم القرى وتوقيت الرياض. راجع المصدر الرسمي قبل أي قرار.
        </p>
      </div>
    </div>
  </section>
)}
