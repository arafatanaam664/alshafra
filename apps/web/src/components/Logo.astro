---
interface Props { tone?: 'light' | 'dark' }
const { tone = 'dark' } = Astro.props;
const mark = tone === 'light' ? 'text-white' : 'text-ink-900';
const mute = tone === 'light' ? 'text-white/60' : 'text-ink-700';
---
<a href="/" class={`group flex items-center gap-2.5 ${mark}`} aria-label="Alshafra">
  <span class="grid h-9 w-9 place-items-center rounded-xl bg-ink-900">
    <svg viewBox="0 0 32 32" class="h-5 w-5" aria-hidden="true">
      <path d="M7 25 L16 6 H18.4 L9.4 25 Z" fill="#b45309"/>
      <path d="M13 25 L22 6 H24.4 L15.4 25 Z" fill="#efe8da"/>
    </svg>
  </span>
  <span class="leading-none">
    <span class="block text-[16px] font-extrabold tracking-tight">Alshafra</span>
    <span class={`mt-0.5 block text-[11px] ${mute}`}>معرفة وأدوات عملية</span>
  </span>
</a>
