---
import type { RelatedLink } from '@alshafra/content/linking';

interface Props {
  links: RelatedLink[];
}

const { links } = Astro.props;
const unique = links.filter((link, index, all) => all.findIndex((item) => item.path === link.path) === index);
---
{unique.length > 0 && (
  <section class="related-links mt-10" aria-labelledby="related-heading">
    <h2 id="related-heading" class="text-lg font-bold">مواضيع ذات صلة</h2>
    <div class="mt-3 grid gap-2 sm:grid-cols-2">
      {unique.map((link) => (
        <a class="card p-3 text-sm font-medium text-ink-800" href={link.path} data-link-reason={link.reason}>
          {link.title}
        </a>
      ))}
    </div>
  </section>
)}
