---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomePlatform from '../components/HomePlatform.astro';
import { getPage } from '../content/provider';

const page = getPage('/');
if (!page) throw new Error('Missing homepage model');
---
<SiteLayout
  title={page.title}
  description={page.description}
  path="/"
  h1={page.h1}
  robots={page.robots}
  kind={page.kind}
  image={page.image}
  imageAlt={page.imageAlt}
  fullBleed
  headerTone="light"
>
  <HomePlatform />
</SiteLayout>
