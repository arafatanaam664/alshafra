---
import SiteLayout from '../layouts/SiteLayout.astro';
import ShareIsland from '../islands/ShareIsland';
import DateConverterIsland from '../islands/DateConverterIsland';
import AgeCalculatorIsland from '../islands/AgeCalculatorIsland';
import CountdownIsland from '../islands/CountdownIsland';
import ToolIsland from '../islands/ToolIsland';
import { getAllPages, type PageModel } from '../content/provider';
import RelatedLinks from '../components/RelatedLinks.astro';
import ExploreShelf from '../components/ExploreShelf.astro';
import { pageKindLabel } from '@alshafra/content/explore';
import { resolveMetadata } from '@alshafra/seo';

export function getStaticPaths() {
  return getAllPages()
    .filter((p) => p.path !== '/')
    .map((p) => ({
      params: { slug: p.path.replace(/^\//, '') },
      props: p,
    }));
}

type Props = PageModel;
const page = Astro.props;
const seo = resolveMetadata(page);
const url = `https://alshafra.com${page.path}`;
const kindLabel = pageKindLabel(page.path);
const headings = [...page.html.matchAll(/<h2[^>]*>(.*?)<\/h2>/gi)].map((match) =>
  match[1].replace(/<[^>]+>/g, '').trim(),
).filter(Boolean);
const sidebar = (page.explore || []).filter((group) => group.key === 'next' || group.key === 'tools');
const rest = (page.explore || []).filter((group) => group.key === 'related' || group.key === 'hub');
---
<SiteLayout
  title={page.title}
  description={page.description}
  path={page.path}
  h1={page.h1}
  robots={page.robots}
  keywords={page.keywords}
  kind={page.kind}
  island={page.island}
  faq={page.faq}
  datePublished={page.datePublished}
  dateModified={page.dateModified}
  isoDate={page.isoDate}
  itemList={page.itemList}
  image={page.image}
  imageAlt={page.imageAlt}
>
  <div class="page-grid">
    <article>
      <p class="eyebrow">{kindLabel}</p>
      <h1 class="section-title mt-2">{seo.h1}</h1>
      {seo.description && <p class="lede mt-4">{seo.description}</p>}
      {headings.length >= 3 && (
        <nav class="card mt-6 p-4 text-sm" aria-label="محتويات الصفحة">
          <p class="font-bold">في هذه الصفحة</p>
          <ul class="mt-2 space-y-1 text-ink-700">
            {headings.slice(0, 8).map((heading) => (
              <li>{heading}</li>
            ))}
          </ul>
        </nav>
      )}
      {page.island === 'date-converter' && <DateConverterIsland client:load />}
      {page.island === 'age-calculator' && <AgeCalculatorIsland client:load />}
      {page.island === 'countdown' && page.isoDate && <CountdownIsland client:visible iso={page.isoDate} />}
      {page.island === 'tool' && page.engineKey && <ToolIsland client:load engineKey={page.engineKey} />}
      <div class="prose-alshafra mt-8 space-y-4" set:html={page.html} />
      <ShareIsland client:visible url={url} title={page.title} />
    </article>
    <aside class="lg:pt-8">
      <ExploreShelf groups={sidebar} compact />
    </aside>
  </div>
  <ExploreShelf groups={rest} />
  {!rest.some((group) => group.key === 'related') && <RelatedLinks links={page.related || []} />}
</SiteLayout>
