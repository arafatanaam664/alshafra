# Browser-safe values from Supabase Project Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server/build only. Never prefix this key with VITE_ and never expose it to a browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Set true in production when a failed CMS export must stop deployment.
CMS_SYNC_REQUIRED=false
