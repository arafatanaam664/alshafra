# Copy to .env.local — never commit real values.
# Names match docs/technical_architecture/46-environment-config.md
# Owner checklist: docs/phase11_media_r2/01-owner-r2-setup.md

PUBLIC_SITE_URL=https://alshafra.com
PUBLIC_ADSENSE_CLIENT=
PUBLIC_GA_ID=
PUBLIC_TURNSTILE_SITE_KEY=
# Public CDN for published objects. Example after DNS: https://media.alshafra.com
PUBLIC_R2_PUBLIC_BASE_URL=

# Optional. Direct Postgres URL for local/tools. Public site stays static-first.
DATABASE_URL=
ALSHAFRA_ENV=development
# legacy | database | composite (default composite = DB snapshot overlay + legacy HTML fallback)
ALSHAFRA_CONTENT_SOURCE=composite

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — leave empty until launch. Local uploads use .data/media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional. Default: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_REGION=auto
# Optional alias for PUBLIC_R2_PUBLIC_BASE_URL
R2_PUBLIC_BASE_URL=
# memory | local | r2   (omit to auto: r2 if keys exist, else local)
MEDIA_DRIVER=
MEDIA_LOCAL_DIR=.data/media

INDEXNOW_KEY=
SOCIAL_TOKEN_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ADSENSE_SLOTS=
CRON_SECRET=
ADMIN_SESSION_SECRET=
# development only — never true in production
ADMIN_DEV_LOGIN=true
