{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "admin:dev": "node scripts/admin-server.mjs",
    "test:admin": "node --test scripts/tests/admin-server.test.mjs scripts/tests/admin-integration.test.mjs",
    "test:dates": "npm run build && node --test scripts/tests/countdown-clock.test.mjs scripts/tests/calendar-data.test.mjs scripts/tests/content-trust.test.mjs scripts/tests/date-validation.test.mjs scripts/tests/age.test.mjs scripts/tests/salary-trust.test.mjs",
    "test:seo": "npm run build && node --test scripts/tests/static-seo.test.mjs scripts/tests/routing.test.mjs",
    "test:ui": "node --test scripts/tests/ui-dom.test.mjs scripts/tests/calendar-unavailable-ui.test.mjs scripts/tests/admin-ui-dom.test.mjs scripts/tests/admin-editor-ui-dom.test.mjs",
    "test:all": "npm run typecheck && npm run lint && npm run test:dates && npm run test:seo && npm run test:admin && npm run test:ui",
    "test:browser": "node --test scripts/tests/browser.test.mjs",
    "perf:browser": "node scripts/browser-lab.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "axe-core": "^4.14.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
